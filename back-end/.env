###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://127.0.0.1
###< symfony/routing ###

###> Database Configuration ###
DATABASE_URL="mysql://user:password@127.0.0.1:3306/knowledge_learning?serverVersion=8.0.32&charset=utf8mb4"
###< Database Configuration ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> Frontend Configuration ###
FRONTEND_URL="http://127.0.0.1:4200"
###< Frontend Configuration ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> stripe/stripe-php ###
STRIPE_SECRET_KEY=secret_key
STRIPE_WEBHOOK_SECRET=whsec_secret_key
PAYMENT_SUCCESS_PATH="/payment/success"
PAYMENT_CANCEL_PATH="/payment/cancel"
###< stripe/stripe-php ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^http://127\.0\.0\.1:4200$'
###< nelmio/cors-bundle ###
